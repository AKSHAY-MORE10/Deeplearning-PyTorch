# Virtual environments
env/
venv/
.venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
pip-wheel-metadata/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
*.log

# Unit test / coverage reports
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582; used by e.g. pythonx
__pypackages__/

# pyright
typings/

# mypy
.mypy_cache/

# PyCharm
.idea/

# VS Code
.vscode/

# PyTorch
*.pt
*.pth

# Data and models (optional - uncomment if you want to ignore datasets/models)
# *.csv
# *.h5
# models/

# OS files
.DS_Store
Thumbs.db

# Misc
*.swp
*~
